<?xml version="1.0"?>
<transfers xmlns="spryker:transfer-01" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="spryker:transfer-01 http://static.spryker.com/transfer-01.xsd">

    <transfer name="CaptchaChallengeRequest" strict="true">
        <property name="context" type="string"/>
        <property name="challengeUrl" type="string" description="URL the widget fetches its challenge from, for a provider that implements CaptchaChallengeUrlProviderPluginInterface."/>
    </transfer>

    <transfer name="CaptchaChallengeResponse" strict="true">
        <property name="isSuccessful" type="bool"/>
        <property name="widget" type="CaptchaWidget"/>
        <property name="messages" type="Message[]" singular="message"/>
    </transfer>

    <transfer name="CaptchaChallengeDataResponse" strict="true">
        <property name="isSuccessful" type="bool"/>
        <property name="challengeData" type="string" description="JSON document of the challenge the widget fetches from the challenge URL."/>
        <property name="messages" type="Message[]" singular="message"/>
    </transfer>

    <transfer name="CaptchaWidget" strict="true">
        <property name="tagName" type="string"/>
        <property name="attributes" type="array" singular="attribute" associative="true"/>
        <property name="nameAttribute" type="string"/>
        <property name="loaderTagName" type="string"/>
        <property name="scriptAssetPaths" type="string[]" singular="scriptAssetPath"/>
    </transfer>

    <transfer name="CaptchaVerificationRequest" strict="true">
        <property name="payload" type="string"/>
        <property name="context" type="string"/>
        <property name="ip" type="string"/>
    </transfer>

    <transfer name="CaptchaVerificationResponse" strict="true">
        <property name="isValid" type="bool"/>
        <property name="isExpired" type="bool"/>
        <property name="messages" type="Message[]" singular="message"/>
        <property name="replayKey" type="string"/>
        <property name="replayExpiresAt" type="int"/>
    </transfer>

    <transfer name="Message">
        <property name="value" type="string"/>
        <property name="parameters" type="array" singular="parameters"/>
    </transfer>

    <transfer name="ConfigurationValue" strict="true">
        <property name="settingKey" type="string"/>
        <property name="scope" type="string"/>
        <property name="value" type="string"/>
    </transfer>

    <transfer name="ConfigurationValueCollectionRequest" strict="true">
        <property name="configurationValues" type="ConfigurationValue[]" singular="configurationValue"/>
    </transfer>

    <transfer name="ConfigurationValueCollectionResponse" strict="true">
        <property name="isSuccess" type="bool"/>
        <property name="savedCount" type="int"/>
        <property name="errors" type="ConfigurationError[]" singular="error"/>
    </transfer>

    <transfer name="ConfigurationError" strict="true">
        <property name="message" type="string"/>
    </transfer>

    <transfer name="ConfigurationSettingValuesCriteria" strict="true">
        <property name="settingKeys" type="array" singular="settingKey"/>
        <property name="scope" type="string"/>
    </transfer>

    <transfer name="ConfigurationSettingValueCollection" strict="true">
        <property name="directValues" type="array" singular="directValue"/>
    </transfer>

</transfers>
